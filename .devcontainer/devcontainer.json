{
  "name": "wagner-cardoso-dev",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "postCreateCommand": "curl -fsSL https://claude.ai/install.sh | bash",
  "postStartCommand": "git config user.name 'Wagner Cardoso' && git config user.email 'wagnerdev01@gmail.com'",

  "forwardPorts": [4321, 4322],
  "portsAttributes": {
    "4321": {
      "label": "site (Astro dev)",
      "onAutoForward": "notify"
    },
    "4322": {
      "label": "blog (Astro dev)",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "unifiedjs.vscode-mdx",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[astro]": {
          "editor.defaultFormatter": "astro-build.astro-vscode"
        },
        "tailwindCSS.experimental.configFile": null
      }
    }
  },

  "remoteUser": "node"
}
