---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<section aria-labelledby="projetos-heading" class="py-18 border-b border-rule">
  <div class="flex items-center gap-6 mb-10">
    <span class="w-2 h-2 bg-accent shrink-0" aria-hidden="true"></span>
    <h2
      id="projetos-heading"
      class="text-[.8rem] uppercase tracking-[.25em] text-fg-strong font-bold"
    >
      Projetos
    </h2>
    <span class="flex-1 h-px bg-rule" aria-hidden="true"></span>
  </div>

  <div class="flex flex-col gap-6">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</section>
