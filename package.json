{
  "name": "wagner-cardoso-dev",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter site --filter blog dev",
    "dev:site": "pnpm --filter site dev",
    "dev:blog": "pnpm --filter blog dev",

    "build": "pnpm --filter site build && pnpm --filter blog build",
    "build:site": "pnpm --filter site build",
    "build:blog": "pnpm --filter blog build",

    "preview": "pnpm --parallel --filter site --filter blog preview",
    "preview:site": "pnpm --filter site preview",
    "preview:blog": "pnpm --filter blog preview"
  },
  "packageManager": "pnpm@9.0.0"
}
