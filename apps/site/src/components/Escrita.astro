---
import { PUBLIC_BLOG_URL } from "astro:env/client";
import { getRecentPosts } from "@content/content";

const posts = await getRecentPosts(5);

// C-3 (docs/specs/002/task-000.md): zero posts is a fatal build state, not a
// renderable empty state. No placeholder copy, no conditional hiding of the
// section — the build must fail loudly instead.
if (posts.length === 0) {
  throw new Error(
    "Escrita section requires at least one post, but getRecentPosts(5) " +
      "returned none. Add at least one post under packages/content/posts."
  );
}

const dateFmt = new Intl.DateTimeFormat("pt-BR", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
---

<section aria-labelledby="escrita-heading" class="py-18 border-b border-rule">
  <div class="flex items-center gap-6 mb-10">
    <span class="w-2 h-2 bg-accent shrink-0" aria-hidden="true"></span>
    <h2
      id="escrita-heading"
      class="text-[.8rem] uppercase tracking-[.25em] text-fg-strong font-bold"
    >
      Escrita
    </h2>
    <span class="flex-1 h-px bg-rule" aria-hidden="true"></span>
  </div>

  <ul class="divide-y divide-rule">
    {posts.map((post) => (
      <li>
        <a
          href={`${PUBLIC_BLOG_URL}/${post.slug}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-baseline justify-between gap-4 py-5 -mx-2 px-2 hover:bg-bg-muted/40 transition-colors duration-150"
        >
          <span class="text-fg-strong group-hover:text-accent transition-colors duration-150">
            {post.title}
          </span>
          <time
            datetime={post.date.toISOString()}
            class="shrink-0 text-sm uppercase tracking-[.14em] text-fg-muted"
          >
            {dateFmt.format(post.date)}
          </time>
        </a>
      </li>
    ))}
  </ul>

  <a
    href={PUBLIC_BLOG_URL}
    class="mt-6 inline-block text-sm text-accent underline underline-offset-4 hover:text-fg-strong transition-colors duration-150"
  >
    Ver tudo →
  </a>
</section>
