---
const links = [
  { label: "Site pessoal", href: "https://wagnercardoso.dev" },
  { label: "LinkedIn", href: "https://linkedin.com/in/wagner-cardoso-dev" },
  { label: "GitHub", href: "https://github.com/wcardosos" },
];
---

<aside class="mt-16 pt-10 border-t border-rule flex gap-5 items-start">
  <img
    src="https://github.com/wcardosos.png"
    alt="Foto de Wagner Cardoso"
    width="72"
    height="72"
    loading="lazy"
    decoding="async"
    class="h-[72px] w-[72px] rounded-[2px] object-cover shrink-0"
  />
  <div>
    <p class="text-fg-strong font-semibold">Wagner Cardoso</p>
    <p class="mt-1 text-sm text-fg-muted">
      Desenvolvedor backend/fullstack na
      <a
        href="https://zrp.com.br"
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent underline underline-offset-4 hover:text-fg-strong transition-colors duration-150"
        >ZRP</a
      >.
    </p>
    <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent underline underline-offset-4 hover:text-fg-strong transition-colors duration-150"
            >
              {l.label} ↗
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>
