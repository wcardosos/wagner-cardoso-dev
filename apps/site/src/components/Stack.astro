---
import { stack } from "../data/stack";
import TechItem from "./TechItem.astro";
---

<section aria-labelledby="stack-heading" class="py-18 border-b border-rule">
  <div class="flex items-center gap-6 mb-10">
    <span class="w-2 h-2 bg-accent shrink-0" aria-hidden="true"></span>
    <h2
      id="stack-heading"
      class="text-[.8rem] uppercase tracking-[.25em] text-fg-strong font-bold"
    >
      Stack
    </h2>
    <span class="flex-1 h-px bg-rule" aria-hidden="true"></span>
  </div>

  <div>
    {
      stack.map((cat) => (
        <div class="grid grid-cols-1 md:grid-cols-[200px_1fr] gap-4 md:gap-8 py-5 border-b border-rule last:border-b-0 md:items-center">
          <h3 class="text-xs font-bold uppercase tracking-[0.18em] text-fg-strong">
            {cat.name}
          </h3>
          <ul class="flex flex-wrap gap-1.5 list-none p-0 m-0">
            {cat.items.map((it) => (
              <TechItem name={it.name} svg={it.svg} />
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
